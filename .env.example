# Mẫu cấu hình. Chép thành .env rồi sửa:  cp .env.example .env
# File .env đã nằm trong .gitignore — KHÔNG commit giá trị thật.
# Mọi biến đều không bắt buộc khi chạy demo trên máy cá nhân.

# --- Bảo mật dashboard
# Có giá trị: mọi lệnh POST (xác nhận/bỏ qua, đổi kịch bản) phải gửi header X-API-Token.
# Để trống: lệnh POST chỉ được nhận từ chính máy chủ (127.0.0.1); máy khác chỉ xem.
# Khi chạy bằng Docker/Caddy BẮT BUỘC đặt (trình duyệt không phải loopback của container).
# Sinh mã ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
EDGE_API_TOKEN=

# --- Đường dẫn (mặc định tính từ gốc repo)
# EDGE_AUDIT_LOG=logs/audit.jsonl
# EDGE_DATA_DIR=data
# EDGE_MODELS_DIR=data/models
# EDGE_RESULTS_DIR=data/results
# EDGE_STATIC_DIR=frontend
# EDGE_LOG_DIR=logs

# --- Chỉ để thử luồng khi CHƯA có trọng số (dashboard hiện băng cảnh báo đỏ)
# EDGE_ALLOW_UNTRAINED=0

# --- Triển khai HTTPS bằng Caddy (deploy/docker-compose.yml)
# Tên miền thật -> Caddy tự xin chứng chỉ Let's Encrypt (cần mở cổng 80/443).
# Để "localhost" -> Caddy dùng CA nội bộ, trình duyệt sẽ cảnh báo chứng chỉ tự ký.
EDGE_DOMAIN=localhost
# Cổng công khai của Caddy (đổi khi 80/443 đã có dịch vụ khác)
# EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443
# Email nhận thư báo chứng chỉ: thêm vào deploy/Caddyfile (xem chú thích ở đó).

# --- Sao lưu nhật ký quyết định (PRD A-16): mỗi ngày, giữ 12 tháng
# Để trống: lưu vào volume Docker "edge-backups" trên ổ đĩa máy trạm.
# EDGE_BACKUP_DIR=/srv/edge-backups      # thư mục máy chủ, phải thuộc uid 10001
# EDGE_BACKUP_INTERVAL_S=86400           # chu kỳ sao lưu (giây)
