# Caddy làm reverse proxy HTTPS cho dashboard Edge AI.
#
# EDGE_DOMAIN=localhost (mặc định): Caddy tự tạo CA nội bộ và cấp chứng chỉ
#   tự ký — trình duyệt sẽ cảnh báo, dùng để thử trên máy.
# EDGE_DOMAIN=ten-mien-that.vn: Caddy tự xin chứng chỉ Let's Encrypt và tự gia
#   hạn (cần DNS trỏ về máy và mở cổng 80/443).
{
	email {$ACME_EMAIL:admin@localhost}
}

{$EDGE_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy app:8099 {
		health_uri /api/health
		health_interval 15s
	}

	log {
		output stdout
		format console
	}
}
